#!/bin/bash

# Claude Code Docker runner

set -e

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

IMAGE_NAME="clauded:latest"
CONTAINER_NAME="clauded-container"
CLAUDE_VOLUME="clauded-volume"
SANDBOX_MODE=false
SHELL_MODE=false
PROFILE=""
PORTS=()

# Expand a bare port number (4242) into a docker publish spec (4242:4242);
# pass anything more specific (e.g. 127.0.0.1:8080:4242) through unchanged.
normalize_port() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "$1:$1"
    else
        echo "$1"
    fi
}

FILTERED_ARGS=()
expect_profile=false
expect_port=false
for arg in "$@"; do
    if [ "$expect_profile" = true ]; then
        PROFILE="$arg"
        expect_profile=false
        continue
    fi
    if [ "$expect_port" = true ]; then
        PORTS+=("$(normalize_port "$arg")")
        expect_port=false
        continue
    fi
    case "$arg" in
        --sandbox|-s)
            SANDBOX_MODE=true
            ;;
        --profile=*)
            PROFILE="${arg#--profile=}"
            ;;
        --profile)
            expect_profile=true
            ;;
        shell)
            # First bare "shell" token is the subcommand; anything after is
            # passed through to bash (e.g. `clauded shell -c "..."`).
            if [ "$SHELL_MODE" = false ]; then
                SHELL_MODE=true
            else
                FILTERED_ARGS+=("$arg")
            fi
            ;;
        --port=*|--publish=*)
            PORTS+=("$(normalize_port "${arg#*=}")")
            ;;
        --port|--publish)
            expect_port=true
            ;;
        *)
            FILTERED_ARGS+=("$arg")
            ;;
    esac
done

if [ "$expect_profile" = true ]; then
    echo -e "${RED}Error: --profile requires a name${NC}" >&2
    exit 1
fi

if [ "$expect_port" = true ]; then
    echo -e "${RED}Error: --port requires a value (e.g. --port 4242)${NC}" >&2
    exit 1
fi

HOME_VOLUME="${CLAUDE_VOLUME}"
if [ -n "$PROFILE" ]; then
    if ! [[ "$PROFILE" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
        echo -e "${RED}Error: Invalid profile name '${PROFILE}'${NC}" >&2
        echo -e "${YELLOW}Profile must start with alphanumeric and contain only [a-zA-Z0-9_.-]${NC}" >&2
        exit 1
    fi
    CONTAINER_NAME="clauded-container-${PROFILE}"
    HOME_VOLUME="${CLAUDE_VOLUME}-${PROFILE}"
fi

# `clauded shell` drops into a bash shell in the already-running container.
if [ "$SHELL_MODE" = true ]; then
    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo -e "${RED}Error: container '${CONTAINER_NAME}' is not running${NC}" >&2
        echo -e "${YELLOW}Start it first with: clauded${PROFILE:+ --profile=${PROFILE}}${NC}" >&2
        exit 1
    fi
    echo -e "${GREEN}🐚 Opening shell in '${CONTAINER_NAME}'...${NC}"
    echo -e "${YELLOW}Note: only /workspace and /home/codespace persist; other changes are lost on restart.${NC}"
    # Host's $TERM (e.g. alacritty) often has no terminfo in the container,
    # which breaks readline line editing (backspace). xterm-256color is always
    # present and universally compatible; COLORTERM still carries truecolor.
    docker exec -it -u codespace -w /workspace \
        -e "TERM=xterm-256color" -e "COLORTERM=${COLORTERM}" \
        "${CONTAINER_NAME}" bash "${FILTERED_ARGS[@]}"
    exit $?
fi

if ! docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
    echo -e "${RED}Error: Docker image '${IMAGE_NAME}' not found${NC}"
    echo -e "${YELLOW}Please run the installation script first.${NC}"
    exit 1
fi

WORK_DIR="$(pwd)"

# Source .env for environment variables (e.g. GITHUB_TOKEN)
if [ -f .env ]; then
    source .env
fi

if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo -e "${RED}⚠️  WARNING: Another instance of '${CONTAINER_NAME}' is running${NC}"
    echo ""
    echo -e "Choose an option:"
    echo -e "  ${CYAN}1${NC}) Attach to running container"
    echo -e "     ${YELLOW}(uses the existing container's configuration)${NC}"
    echo -e "  ${CYAN}2${NC}) Stop previous instance and start fresh"
    echo -e "     ${YELLOW}(uses new configuration)${NC}"
    echo -e "  ${CYAN}3${NC}) Exit"
    echo ""

    while true; do
        read -p "Enter your choice (1/2/3) [default: 1]: " answer
        # Default to 1 if answer is empty
        answer="${answer:-1}"

        # Validate input is 1, 2, or 3
        if [[ ! "$answer" =~ ^[123]$ ]]; then
            echo "Please enter 1, 2, or 3."
            continue
        fi

        case "$answer" in
            1 )
                echo -e "${GREEN}Reusing existing instance...${NC}"
                [ ${#PORTS[@]} -gt 0 ] && echo -e "${YELLOW}Note: --port is ignored when attaching; choose option 2 to apply new port mappings.${NC}"
                docker exec -it -u codespace \
                    -e "TERM=xterm-256color" -e "COLORTERM=${COLORTERM}" \
                    "${CONTAINER_NAME}" claude --dangerously-skip-permissions "${FILTERED_ARGS[@]}"
                echo -e "${GREEN}Detaching, container is still running.${NC}"
                exit 0
                ;;
            2 )
                echo -e "${YELLOW}Stopping previous instance...${NC}"
                docker exec "${CONTAINER_NAME}" sh -c "
                    for tty in /dev/pts/*; do
                        [ -w \"\$tty\" ] && echo -e '\n${RED}⚠️  WARNING: Another container instance is starting, bye.${NC}\n' > \"\$tty\" 2>/dev/null || true
                    done
                " 2>/dev/null || true
                docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
                break
                ;;
            3 )
                exit 0
                ;;
            * )
                echo "Please enter 1, 2, or 3."
                ;;
        esac
    done
fi

if ! docker volume inspect "${HOME_VOLUME}" > /dev/null 2>&1; then
    echo -e "${YELLOW}Creating persistent volume '${HOME_VOLUME}'...${NC}"
    docker volume create "${HOME_VOLUME}" >/dev/null
    # Best-effort seed from default so existing OAuth credentials carry over.
    if [ -n "$PROFILE" ] && docker volume inspect "${CLAUDE_VOLUME}" > /dev/null 2>&1; then
        docker run --rm --entrypoint sh \
            -v "${CLAUDE_VOLUME}:/clauded-from:ro" \
            -v "${HOME_VOLUME}:/clauded-to" \
            "${IMAGE_NAME}" \
            -c 'cp -a /clauded-from/. /clauded-to/' >/dev/null || true
    fi
fi

echo -e "${GREEN}🐳 Starting Claude Code...${NC}"
if [ -n "$PROFILE" ]; then
    echo -e "🏷️ Profile: ${CYAN}${PROFILE}${NC}"
fi
if [ "$SANDBOX_MODE" = true ]; then
    echo -e "⚙️ Mode: sandboxed (${CYAN}no host directory mounted${NC})"
else
    echo -e "⚙️ Mode: ${YELLOW}mounted${NC} (${CYAN}${WORK_DIR}${NC})"
fi
if [ ${#PORTS[@]} -gt 0 ]; then
    echo -e "🌐 Publishing: ${CYAN}${PORTS[*]}${NC}"
fi

files=(
    .env
    .envrc
)

dirs=(
    .ssh
    config/credentials
    config/secrets
    credentials
    secrets
)

DOCKER_ARGS=(
    --rm -it
    --name "${CONTAINER_NAME}"
    --security-opt no-new-privileges:true
    --network bridge
)

# Publish requested ports to the host (repeatable via --port)
for port in "${PORTS[@]}"; do
    DOCKER_ARGS+=(-p "$port")
done

# Add tmpfs mounts for sensitive directories and exclude sensitive files (non-sandbox mode only)
MASKED_DIRS=""
EXCLUDED_FILES=""
if [ "$SANDBOX_MODE" != true ]; then
    for dir in "${dirs[@]}"; do
        if [ -d "$dir" ]; then
            DOCKER_ARGS+=(--tmpfs "/workspace/${dir}")
            MASKED_DIRS+="$dir, "
        fi
    done
    for file in "${files[@]}"; do
        if [ -f "$file" ]; then
            DOCKER_ARGS+=(--volume /dev/null:"/workspace/${file}":ro)
            EXCLUDED_FILES+="$file, "
        fi
    done
    MASKED_DIRS="${MASKED_DIRS%, }"
    EXCLUDED_FILES="${EXCLUDED_FILES%, }"
    [ -n "$MASKED_DIRS" ] && echo "🔒 Masking with tmpfs: $MASKED_DIRS"
    [ -n "$EXCLUDED_FILES" ] && echo "🔒 Excluding files: $EXCLUDED_FILES"
fi


# Environment variables
DOCKER_ARGS+=(
    -e "HOST_UID=$(id -u)"
    -e "HOST_GID=$(id -g)"
    -e "TERM=${TERM}"
    -e "COLORTERM=${COLORTERM}"
)

# Pass GITHUB_TOKEN for gh CLI authentication
if [ -n "${GITHUB_TOKEN:-}" ]; then
    DOCKER_ARGS+=(-e "GITHUB_TOKEN=${GITHUB_TOKEN}")
fi

# Volumes
if [ "$SANDBOX_MODE" = true ]; then
    DOCKER_ARGS+=(
        -v "${HOME_VOLUME}:/home/codespace:rw"
        -w /workspace
    )
else
    DOCKER_ARGS+=(
        -v "${WORK_DIR}:/workspace:rw"
        -v "${HOME_VOLUME}:/home/codespace:rw"
        -w /workspace
    )

    # Claude Code keeps per-project state (memory + session transcripts) under
    # ~/.claude/projects/<cwd-slug>. Because the workdir is always mounted at
    # /workspace, that slug is always "-workspace" — which means every host
    # project would otherwise share one store inside the home volume. Bind the
    # fixed path back to the project so memory and history follow the code.
    #
    # Two mounts, nested: the transcripts mount covers the whole project dir,
    # and the memory mount lands on top of it so memory gets its own tidy,
    # commit-friendly location. Docker mounts destinations shallowest-first, so
    # the nesting resolves in the right order.
    PROJECT_STATE_DIR="/home/codespace/.claude/projects/-workspace"
    # ".../transcripts/memory" is pre-created so Docker doesn't materialise the
    # (shadowed, always-empty) mount point as root inside the project.
    mkdir -p "${WORK_DIR}/.claude/memory" "${WORK_DIR}/.claude/transcripts/memory"
    DOCKER_ARGS+=(
        -v "${WORK_DIR}/.claude/transcripts:${PROJECT_STATE_DIR}:rw"
        -v "${WORK_DIR}/.claude/memory:${PROJECT_STATE_DIR}/memory:rw"
    )
    echo -e "🧠 Memory: ${CYAN}${WORK_DIR}/.claude/memory${NC}"
    echo -e "💬 Transcripts: ${CYAN}${WORK_DIR}/.claude/transcripts${NC}"
fi

docker run "${DOCKER_ARGS[@]}" \
    "${IMAGE_NAME}" \
    claude --dangerously-skip-permissions \
    "${FILTERED_ARGS[@]}"

echo -e "${GREEN}Container stopped.${NC}"
